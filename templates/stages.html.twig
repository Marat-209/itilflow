{#
   Вкладка «Этапы» маршрута: строка готовности и таблица
   № · Этап · Как выполняется · Когда · Кто · Срок · Если отказ · Порядок.
   «Когда» — условие обычной фразой; «Если отказ» — по порядку исходов маршрута.
   Стрелки меняют номер с соседним этапом (обычное сохранение обоих), «Убрать» — удаление этапа.
   На узком экране строки — карточки.
#}
{{ include('@itilflow/readiness.html.twig', {'r': readiness, 'stage_view': false}) }}

<div class="mb-3">
   {% if can_edit %}
      <a class="btn btn-primary"
         href="{{ path('/plugins/itilflow/front/stage.form.php') }}?plugin_itilflow_processes_id={{ process.fields['id'] }}">
         <i class="ti ti-plus me-1"></i>Добавить этап
      </a>
   {% endif %}
</div>

{% if rows|length == 0 %}
   <div class="alert alert-info">Этапов пока нет.</div>
{% else %}
   {% set action = path('/plugins/itilflow/front/stage.form.php') %}
   <style>
      @media (max-width: 575.98px) {
         .itilflow-stages thead { display: none; }
         .itilflow-stages tr { display: block; border-bottom: 1px solid var(--tblr-border-color, #e6e7e9); padding: .5rem 0; }
         .itilflow-stages td { display: flex; gap: .5rem; border: 0; padding: .15rem .5rem; }
         .itilflow-stages td::before { content: attr(data-label); flex: 0 0 7.5rem; color: var(--tblr-secondary, #667382); }
      }
      .itilflow-stages tr.itilflow-problem > td:first-child { box-shadow: inset 3px 0 0 var(--tblr-warning, #f59f00); }
      .itilflow-stages .itilflow-order { display: flex; flex-wrap: wrap; gap: .25rem; }
      .itilflow-stages .itilflow-order form { display: inline; margin: 0; }
   </style>
   <table class="table table-hover itilflow-stages">
      <thead>
         <tr>
            <th style="width:56px">№</th>
            <th>Этап</th>
            <th>Как выполняется</th>
            <th>Когда</th>
            <th>Кто</th>
            <th>Срок</th>
            <th>Если отказ</th>
            {% if can_edit %}<th>Порядок</th>{% endif %}
         </tr>
      </thead>
      <tbody>
      {% for s in rows %}
         <tr data-itilflow-stage="{{ s.id }}" class="{{ s.problems is not empty ? 'itilflow-problem' : '' }}">
            <td class="fw-bold" data-label="№">{{ s.ranking }}</td>
            <td data-label="Этап">
               <span>
                  {% if can_edit %}
                     <a href="{{ action }}?id={{ s.id }}" aria-label="Настроить этап {{ s.ranking }} «{{ s.name }}»">{{ s.name }}</a>
                  {% else %}
                     {{ s.name }}
                  {% endif %}
                  {% if s.report_required %}<span class="badge bg-secondary-lt ms-1">отчёт обязателен</span>{% endif %}
                  {% if s.is_optional %}<span class="badge bg-secondary-lt ms-1">можно пропустить</span>{% endif %}
                  {% for p in s.problems %}
                     <span class="d-block small text-danger" data-itilflow-row-problem>{{ p }}</span>
                  {% endfor %}
                  {% for n in s.notes ?? [] %}
                     <span class="d-block small text-warning" data-itilflow-row-note>{{ n }}</span>
                  {% endfor %}
               </span>
            </td>
            <td data-label="Как выполняется">{{ s.mode }}</td>
            <td data-label="Когда">{{ s.when }}</td>
            <td data-label="Кто" data-itilflow-col="who">
               <span>
                  {% if s.who is empty %}<span class="text-danger">не выбран</span>{% else %}{{ s.who }}{% endif %}
                  {% if s.who_sub is not empty %}<span class="d-block small text-muted">{{ s.who_sub }}</span>{% endif %}
               </span>
            </td>
            <td data-label="Срок" data-itilflow-col="deadline">{{ s.deadline }}</td>
            <td data-label="Если отказ" data-itilflow-col="reject">
               <span>
                  {{ s.reject }}
                  {% if s.reject_sub is not empty %}<span class="d-block small text-muted">{{ s.reject_sub }}</span>{% endif %}
               </span>
            </td>
            {% if can_edit %}
               <td data-label="Порядок">
                  <div class="itilflow-order">
                     {% for dir in ['up', 'down'] %}
                        <form method="post" action="{{ action }}">
                           <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                           <input type="hidden" name="id" value="{{ s.id }}">
                           <button type="submit" class="btn btn-sm btn-outline-secondary" name="move" value="{{ dir }}"
                                   aria-label="{{ dir == 'up' ? 'Поднять' : 'Опустить' }} этап {{ s.ranking }} «{{ s.name }}»"
                                   {% if (dir == 'up' and loop.parent.loop.first) or (dir == 'down' and loop.parent.loop.last) %}disabled{% endif %}>{{ dir == 'up' ? '↑' : '↓' }}</button>
                        </form>
                     {% endfor %}
                     <form method="post" action="{{ action }}">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="id" value="{{ s.id }}">
                        <input type="hidden" name="plugin_itilflow_processes_id" value="{{ process.fields['id'] }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger" name="purge" value="1"
                                aria-label="Убрать этап {{ s.ranking }} «{{ s.name }}»"
                                onclick="return confirm({{ ('Убрать этап ' ~ s.ranking ~ ' «' ~ s.name ~ '»?')|json_encode }});">Убрать</button>
                     </form>
                  </div>
               </td>
            {% endif %}
         </tr>
      {% endfor %}
      </tbody>
   </table>
{% endif %}
