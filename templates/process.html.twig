{% import 'components/form/fields_macros.html.twig' as fields %}

{#
   Форма маршрута: строка готовности, основные поля, «Запуск маршрута» и «Дополнительно» со сводкой.
   Новый маршрут сразу в новом порядке исходов — выбора порядка в форме нет.
   У старого маршрута — плашка «Перевести на новый порядок».
   «Запуск маршрута»: форма, назначение формы, согласование назначения,
   вопросы формы в условиях этапов, «Запускать, если» — общий редактор условий и
   «Другие маршруты этой формы». start — Process::startView.
#}

{% macro hint(text, more = '', more_id = '') %}
   <div class="form-text itilflow-hint">
      {{ text }}
      {% if more is not empty %}
         <a class="link-secondary ms-1" data-bs-toggle="collapse" href="#{{ more_id }}" role="button"
            aria-expanded="false" aria-controls="{{ more_id }}">Подробнее</a>
      {% endif %}
   </div>
   {% if more is not empty %}
      <div class="collapse form-text" id="{{ more_id }}">{{ more }}</div>
   {% endif %}
{% endmacro %}

{% set rand = random() %}
{% set params = params ?? [] %}
{% set target = params['target'] ?? item.getFormURL() %}

<div class="asset">
   {% if readiness is defined and readiness is not null %}
      {# Пересчёт без сохранения заменяет содержимое блока (front/draft.php). #}
      <div class="px-3 pt-3" data-itilflow-readiness-box aria-live="polite">
         {{ include('@itilflow/readiness.html.twig', {'r': readiness, 'stage_view': false}) }}
      </div>
   {% endif %}
   {% if legacy is defined and legacy is not null %}
      <div class="px-3 pt-3">
         {{ include('@itilflow/legacy.html.twig', {'legacy': legacy, 'item': item, 'rand': rand}) }}
      </div>
   {% endif %}

   {# На узком экране подпись поля во всю ширину — над полем, а не в узкой колонке слева. #}
   <style>
      @media (max-width: 767.98px) {
         .itilflow-form .col-12.glpi-full-width .col-form-label,
         .itilflow-form .col-12.glpi-full-width .field-container { width: 100%; }
      }
      {# Подсказки под полями: в тёмных палитрах GLPI цвет Tabler для form-text не переопределён —
         тёмный текст на тёмном фоне. Там — от цвета текста палитры. То же правило — в форме этапа. #}
      [data-glpi-theme-dark="1"] .itilflow-form .form-text { color: color-mix(in srgb, var(--tblr-body-color) 90%, var(--tblr-bg-surface)); }
      .itilflow-form .itilflow-start-line { border: 1px solid var(--tblr-border-color); border-radius: 6px; padding: .4rem .7rem; margin-bottom: .5rem; }
      .itilflow-form .itilflow-start-line.itilflow-start-warn { border-color: var(--tblr-warning); }
      .itilflow-form .itilflow-start-sum { color: var(--tblr-secondary); font-size: .9em; }
      [data-glpi-theme-dark="1"] .itilflow-form .itilflow-start-sum { color: color-mix(in srgb, var(--tblr-body-color) 80%, var(--tblr-bg-surface)); }
   </style>
   <form class="itilflow-form" name="itilflow_process_form" id="itilflow-process-{{ rand }}" method="post" action="{{ target }}" data-submit-once
         {% if draft_url|default('') %}data-itilflow-draft-url="{{ draft_url }}"{% endif %}>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      {% if not item.isNewItem() %}
         <input type="hidden" name="id" value="{{ item.fields['id'] }}">
      {% elseif new_contract is defined and new_contract is not empty %}
         {# Новый маршрут сразу в новом порядке исходов; полноту показывает строка готовности. #}
         <input type="hidden" name="outcome_contract" value="{{ new_contract }}">
      {% endif %}

      <div class="card-body d-flex flex-wrap">
         <div class="col-12 col-xxl-10 flex-column">
            <div class="row flex-row">

               {{ fields.smallTitle('Маршрут', 'ti ti-route') }}

               {{ fields.textField('name', item.fields['name'], 'Название маршрута', {
                  'required': true,
                  'add_field_attribs': {'data-itilflow-field': 'name'},
                  'add_field_html': _self.hint('Видят исполнители и инициатор.'),
               }) }}

               {{ fields.dropdownField('Entity', 'entities_id', item.fields['entities_id'], 'Организация', {
                  'add_field_attribs': {'data-itilflow-field': 'entities_id'},
                  'add_field_html': _self.hint('Маршрут применяется к заявкам этой организации.'),
               }) }}

               {{ fields.dropdownYesNo('is_recursive', item.fields['is_recursive'], 'Подчинённые организации', {
                  'add_field_attribs': {'data-itilflow-field': 'is_recursive', 'id': 'itilflow-recursive'},
               }) }}

               {{ fields.dropdownField('Calendar', 'calendars_id', item.fields['calendars_id'], 'Рабочий календарь', {
                  'entity': -1,
                  'add_field_attribs': {'data-itilflow-field': 'calendars_id'},
                  'add_field_html': _self.hint('По нему считаются сроки этапов. Не выбран — круглосуточно.'),
               }) }}

               {{ fields.dropdownYesNo('is_active', item.fields['is_active'], 'Маршрут включён', {
                  'add_field_attribs': {'data-itilflow-field': 'is_active', 'id': 'itilflow-active'},
                  'add_field_html': _self.hint('Выключенный маршрут не запускается на новых заявках. Уже начатые идут до конца.'),
               }) }}

               {{ fields.textareaField('comment', item.fields['comment'], 'Описание', {
                  'full_width': true,
                  'add_field_attribs': {'data-itilflow-field': 'comment'},
                  'add_field_html': _self.hint('Видят только администраторы маршрутов.'),
               }) }}

               {% if structured and item.fields['itemtype'] == 'Ticket' %}
                  {# ---------------------------------------------- Запуск маршрута #}
                  {{ fields.smallTitle('Запуск маршрута', 'ti ti-player-play') }}
                  {% if start is defined and start is not null %}
                     <div class="col-12 px-3 mb-2 itilflow-start-sum" data-itilflow-start-summary>{{ start.summary }}</div>
                  {% endif %}
                  {{ fields.dropdownArrayField('forms_forms_id', item.fields['forms_forms_id'] ?? 0, form_sources, 'Форма', {
                     'add_field_html': _self.hint('Сохраните маршрут — появятся назначения и вопросы формы.'),
                  }) }}
                  {{ fields.dropdownArrayField('forms_destinations_id', item.fields['forms_destinations_id'] ?? 0, form_destinations, 'Назначение формы', {
                     'add_field_html': _self.hint('Назначение, которое создаёт заявку.'),
                  }) }}
                  {% if start is defined and start is not null %}
                     <div class="col-12 px-3" data-itilflow-start>
                        <div class="form-text text-warning mb-2" data-itilflow-form-changed hidden>
                           Форма изменена — сохраните маршрут.
                        </div>
                        {% if start.info.no_form %}
                           <div class="itilflow-start-line itilflow-start-warn" data-itilflow-start-line>{{ start.info.no_form }}</div>
                        {% endif %}
                        {% for line in start.info.approvals %}
                           <div class="itilflow-start-line" data-itilflow-start-line>{{ line }}</div>
                        {% endfor %}
                        {% if start.info.questions %}
                           <div class="itilflow-start-line" data-itilflow-start-line>{{ start.info.questions }}</div>
                        {% endif %}
                        {% if start.editor %}
                           {{ include('@itilflow/condition_editor.html.twig', start.editor) }}
                           <div class="mt-3 mb-2" data-itilflow-siblings>
                              <div class="fw-semibold mb-1">Другие маршруты этой формы</div>
                              {% if start.siblings is empty %}
                                 <div class="form-text">Других нет.</div>
                              {% else %}
                                 <ul class="mb-0">
                                    {% for s in start.siblings %}
                                       <li><a href="{{ s.url }}">{{ s.name }}</a> <span class="itilflow-start-sum">— {{ s.destination }}, {{ s.summary }}</span></li>
                                    {% endfor %}
                                 </ul>
                              {% endif %}
                           </div>
                        {% endif %}
                     </div>
                  {% endif %}
               {% endif %}

               {# -------------------------------------------------------- Дополнительно #}
               <div class="col-12 mt-2">
                  <button type="button" class="btn btn-ghost-secondary w-100 justify-content-start text-start"
                          data-bs-toggle="collapse" data-bs-target="#itilflow-pmore-{{ rand }}" aria-expanded="false"
                          aria-controls="itilflow-pmore-{{ rand }}" data-itilflow-more-toggle>
                     <i class="ti ti-dots me-2"></i><span class="fw-semibold">Дополнительно</span>
                     <span class="text-muted small ms-2 text-truncate" data-itilflow-summary></span>
                     <i class="ti ti-chevron-down ms-auto"></i>
                  </button>
               </div>
               <div class="collapse col-12" id="itilflow-pmore-{{ rand }}" data-itilflow-more>
                  <div class="row">
                     {{ fields.dropdownArrayField('itemtype', item.fields['itemtype'], itemtypes, 'Для чего маршрут', {
                        'add_field_attribs': {'data-itilflow-field': 'itemtype', 'data-itilflow-s': 'Для чего'},
                        'add_field_html': _self.hint('После первых запусков не меняйте.'),
                     }) }}

                     {{ fields.dropdownArrayField('enforcement', item.fields['enforcement'], enforcements, 'Если действие не по порядку этапов', {
                        'add_field_attribs': {'data-itilflow-field': 'enforcement', 'data-itilflow-s': 'Не по порядку'},
                        'add_field_html': _self.hint('Права на заявку проверяются всегда.'),
                     }) }}

                     {{ fields.dropdownYesNo('block_resolution', item.fields['block_resolution'], 'Решить заявку — только после всех этапов', {
                        'add_field_attribs': {'data-itilflow-field': 'block_resolution', 'data-itilflow-s': 'Решение после всех этапов'},
                     }) }}

                     {{ fields.dropdownYesNo('public_log', item.fields['public_log'], 'Писать ход этапов в ленту заявки', {
                        'add_field_attribs': {'data-itilflow-field': 'public_log', 'data-itilflow-s': 'Ход в ленте'},
                        'add_field_html': _self.hint('Последнее «Что сделано» станет решением заявки.'),
                     }) }}

                     {{ fields.dropdownYesNo('helpdesk_tab', item.fields['helpdesk_tab'], 'Вкладка маршрута у инициатора', {
                        'add_field_attribs': {'data-itilflow-field': 'helpdesk_tab', 'data-itilflow-s': 'Вкладка у инициатора'},
                     }) }}

                     {{ fields.dropdownYesNo('allow_withdraw', item.fields['allow_withdraw'], 'Инициатор может отозвать заявку', {
                        'add_field_attribs': {'data-itilflow-field': 'allow_withdraw', 'data-itilflow-s': 'Отзыв'},
                        'add_field_html': _self.hint('Маршрут прервётся.'),
                     }) }}

                     {% if not item.isNewItem() %}
                        {{ fields.readOnlyField('version', item.fields['version'], 'Версия', {
                           'add_field_attribs': {'data-itilflow-field': 'version', 'data-itilflow-s': 'Версия'},
                           'add_field_html': _self.hint(structured
                              ? 'Начатые заявки идут по своей версии.'
                              : 'Растёт при каждом сохранении. Начатые заявки идут по текущей настройке этапов.'),
                        }) }}
                     {% endif %}
                  </div>
               </div>

            </div>
         </div>
      </div>

      <div class="card-footer mx-n2 mb-n2 mt-4">
         <div class="d-flex flex-row-reverse align-items-start">
            {# Только кнопки, которые сервер разрешит: с одним «Чтением» — ни «Сохранить», ни «Удалить навсегда». #}
            {% set b = buttons|default({}) %}
            {% if b.add|default(false) %}
               <button class="btn btn-primary" type="submit" name="add" value="1">{{ __('Add') }}</button>
            {% endif %}
            {% if b.update|default(false) %}
               <button class="btn btn-primary" type="submit" name="update" value="1">{{ __('Save') }}</button>
            {% endif %}
            {% if b.purge|default(false) %}
               <button class="btn btn-outline-danger me-2" type="submit" name="purge" value="1"
                       onclick="return confirm('{{ __('Confirm the final deletion?') }}');">{{ __('Delete permanently') }}</button>
            {% endif %}
         </div>
      </div>
   </form>
</div>

<script>
(function () {
   'use strict';
   // Строка-сводка свёрнутого «Дополнительно». Без глобальных имён.
   var form = document.getElementById('itilflow-process-{{ rand }}');
   if (!form) {
      return;
   }
   var changed = form.querySelector('[data-itilflow-form-changed]');
   // Выбор другой формы не переносит старое назначение по совпадению номера; вопросы новой
   // формы появятся в «Запускать, если» после сохранения.
   $(form).on('change', '[name="forms_forms_id"]', function () {
      $(form).find('[name="forms_destinations_id"]').val('0').trigger('change');
      if (changed) {
         changed.hidden = false;
      }
   });
   var more = form.querySelector('[data-itilflow-more]');
   var summary = form.querySelector('[data-itilflow-summary]');
   function shownValue(field) {
      var sel = field.querySelector('select');
      if (sel) {
         var opt = sel.options[sel.selectedIndex];
         var t = opt ? opt.text.trim() : '';
         return t === '' || t.indexOf('-----') === 0 ? '—' : t.split(' — ')[0];
      }
      var box = field.querySelector('.form-control');
      return box ? (box.textContent || '').trim() : '';
   }
   function update() {
      if (!more || !summary) {
         return;
      }
      var parts = [];
      more.querySelectorAll('[data-itilflow-s]').forEach(function (f) {
         parts.push(f.getAttribute('data-itilflow-s') + ': ' + shownValue(f));
      });
      summary.textContent = more.classList.contains('show') ? '' : parts.join(' · ');
   }
   form.addEventListener('change', update);
   if (window.jQuery) {
      window.jQuery(form).on('change', 'select', update);
   }
   if (more) {
      more.addEventListener('shown.bs.collapse', update);
      more.addEventListener('hidden.bs.collapse', update);
   }
   update();

   // Пересчёт без сохранения: строка готовности и нулевой пункт «Назначения формы».
   // Если на форме есть редактор «Запускать, если», запрос шлёт он (событие itilflow:draft),
   // иначе — этот скрипт (_itilflow_draft = process).
   var draftUrl = form.getAttribute('data-itilflow-draft-url');
   var box = form.parentElement ? form.parentElement.querySelector('[data-itilflow-readiness-box]') : null;
   function applyDraft(data) {
      if (!data) {
         return;
      }
      if (box && typeof data.readiness_html === 'string') {
         box.innerHTML = data.readiness_html;
      }
      var dest = form.querySelector('select[name="forms_destinations_id"]');
      var zero = dest ? dest.querySelector('option[value="0"]') : null;
      if (zero && typeof data.destination_zero === 'string' && zero.text !== data.destination_zero) {
         zero.text = data.destination_zero;
         if (window.jQuery) {
            window.jQuery(dest).trigger('change.select2');
         }
      }
   }
   form.addEventListener('itilflow:draft', function (e) { applyDraft(e.detail || null); });
   var startEditor = form.querySelector('[data-draft-url][data-scope=start]');
   if (draftUrl && !startEditor && window.fetch && window.FormData) {
      var timer = null, seq = 0;
      var send = function () {
         var mine = ++seq;
         var body = new FormData(form);
         body.append('_itilflow_draft', 'process');
         var token = form.querySelector('input[name="_glpi_csrf_token"]');
         window.fetch(draftUrl, {
            method: 'POST', body: body, credentials: 'same-origin',
            headers: {'X-Requested-With': 'XMLHttpRequest', 'X-Glpi-Csrf-Token': token ? token.value : ''}
         }).then(function (r) {
            return r.ok ? r.json() : Promise.reject(r.status);
         }).then(function (data) {
            if (mine === seq) {
               applyDraft(data);
            }
         }).catch(function () {});
      };
      var schedule = function () {
         clearTimeout(timer);
         timer = setTimeout(send, 450);
      };
      form.addEventListener('change', schedule);
      if (window.jQuery) {
         window.jQuery(form).on('change', 'select', schedule);
      }
   }
})();
</script>
