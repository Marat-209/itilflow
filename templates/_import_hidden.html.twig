{# Скрытые поля шагов импорта: файл, убранные маршруты, копии, выбранные замены. Замены — одним полем JSON:
   сотни полей упёрлись бы в max_input_vars PHP. Ключ CSRF — первым полем каждой формы. #}
<input type="hidden" name="json" value="{{ json }}" />
{% for id in skipped %}
    <input type="hidden" name="skipped_routes[]" value="{{ id }}" />
{% endfor %}
{% for id in copies %}
    <input type="hidden" name="copy_routes[]" value="{{ id }}" />
{% endfor %}
<input type="hidden" name="replacements_json" value="{{ replacements|json_encode }}" />
