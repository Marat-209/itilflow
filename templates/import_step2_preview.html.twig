{# Импорт маршрутов, шаг 2 — предпросмотр. Как templates/pages/admin/form/import/step2_preview.html.twig GLPI 11:
   «Готов к импорту» / «Не может быть импортирован», «Устранять проблемы», корзина — убрать из списка.
   Сверх того — маршрут с занятым именем: по умолчанию пропуск, по выбору копия. #}
{% extends "layout/page_without_tabs.html.twig" %}

{% set container_size = "narrow" %}

{% block content_title %}
    Импорт маршрутов
{% endblock content_title %}

{% block content_body %}
    {% set question_states = {
        'found': 'Найдено автоматически',
        'missing': 'Выберите вопрос',
        'several': 'Найдено несколько — выберите вопрос',
        'by_id': 'Проверьте выбранный вопрос',
        'replaced': 'Выбрано вручную',
    } %}
    <form method="POST" action="{{ action }}?step=execute" data-submit-once>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />
        <div class="card">
            <div class="card-header py-3 px-4">
                <h3 class="card-title">Предварительный просмотр импорта</h3>
            </div>
            <div class="card-body py-2 px-4">
                Маршруты создаются выключенными — включите их после проверки. Существующие маршруты импорт не меняет.
            </div>
            <table class="table table-card mb-0">
                <thead>
                    <tr>
                        <th class="px-4" style="width: 38%">Маршрут</th>
                        <th class="px-4" style="width: 40%">Статус</th>
                        <th class="px-4" style="width: 22%">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    {% for r in rows %}
                        {% if r.status == 'ready' %}
                            {% set icon = 'ti-check text-success' %}
                            {% set status = 'Готов к импорту' %}
                        {% elseif r.status == 'invalid' and r.choose|default(0) > 0 %}
                            {% set icon = 'ti-hand-click text-warning' %}
                            {% set status = 'Нужно выбрать: ' ~ r.choose %}
                        {% elseif r.status == 'exists' %}
                            {% set icon = 'ti-player-skip-forward' %}
                            {% set status = 'Маршрут с таким именем уже есть — будет пропущен' %}
                        {% else %}
                            {% set icon = 'ti-x text-danger' %}
                            {% set status = 'Не может быть импортирован' %}
                        {% endif %}
                        <tr>
                            <td class="px-4 align-middle">
                                <div>{{ r.name }}</div>
                                <div class="small mt-2"><strong>Запуск маршрута:</strong> {{ r.start_summary }}</div>
                                {% if r.start_questions is not empty %}
                                    <div class="small mt-2">Вопросы запуска: из файла → в выбранной форме</div>
                                    <ul class="small mb-0 ps-3">
                                        {% for question in r.start_questions %}
                                            <li>
                                                {{ question.label }} → {{ question.mapped_label is not empty ? question.mapped_label : 'Вопрос не выбран' }}
                                                <span class="d-block text-muted">{{ question_states[question.state]|default('Проверьте сопоставление') }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </td>
                            <td class="px-4 align-middle">
                                <div class="d-flex align-items-start">
                                    <i class="ti {{ icon }} me-2 mt-1" aria-hidden="true"></i>
                                    <div>
                                        <span>{{ status }}</span>
                                        {% for d in r.details %}
                                            <div class="small">{{ d }}</div>
                                        {% endfor %}
                                    </div>
                                </div>
                            </td>
                            <td class="px-4 align-middle">
                                <div class="d-flex flex-row-reverse flex-wrap align-items-center justify-content-start gap-2">
                                    {% if r.copy is same as(false) %}
                                        <button type="submit" class="btn btn-link p-0" name="copy_routes[]" value="{{ r.id }}"
                                                formaction="{{ action }}?step=preview">
                                            Создать копией
                                        </button>
                                    {% else %}
                                        <button type="submit" class="btn btn-link p-0 text-danger" name="skipped_routes[]" value="{{ r.id }}"
                                                formaction="{{ action }}?step=preview"
                                                title="Удалите этот маршрут из списка импорта"
                                                aria-label="Удалить маршрут «{{ r.name }}» из списка импорта">
                                            <i class="ti ti-trash" aria-hidden="true"></i>
                                        </button>
                                    {% endif %}
                                    {% if r.copy is same as(true) %}
                                        <span class="vr"></span>
                                        <button type="submit" class="btn btn-link p-0" name="uncopy" value="{{ r.id }}"
                                                formaction="{{ action }}?step=preview">
                                            Не создавать копию
                                        </button>
                                    {% endif %}
                                    {% if r.resolve %}
                                        <span class="vr"></span>
                                        <button type="submit" class="btn btn-link p-0" name="route_id" value="{{ r.id }}"
                                                formaction="{{ action }}?step=resolve">
                                            Устранять проблемы
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="row mt-3">
            <div class="col">
                <div class="justify-content-end align-items-center d-flex gap-2">
                    {# Маршрут с занятым именем ждёт «Создать копией» — строка этого маршрута уже это говорит,
                       вторая причина рядом читалась бы как «импорт невозможен». #}
                    {% if ready == 0 and rows|filter(r => r.status == 'exists')|length == 0 %}
                        <span class="me-auto">Нечего импортировать: нет маршрутов «Готов к импорту».</span>
                    {% endif %}
                    <a href="{{ list }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary" {{ ready == 0 ? 'disabled' : '' }}>Импорт</button>
                </div>
            </div>
        </div>

        {{ include('@itilflow/_import_hidden.html.twig') }}
    </form>
{% endblock content_body %}
